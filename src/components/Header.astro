---
import Nav from './Nav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  hasAlternate?: boolean;
}

const { lang, hasAlternate = true } = Astro.props;
const t = useTranslations(lang);
---

<header class="border-b border-mangrove-100">
  <!-- Garis tipis biru-oranye di puncak halaman, dari warna logo. -->
  <div class="h-1 bg-gradient-to-r from-brand-700 via-brand-700 via-70% to-sun-400" aria-hidden="true"></div>
  <div class="mx-auto max-w-4xl px-4 py-4 sm:py-5">
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      <a
        href={`/${lang}/`}
        class="flex shrink-0 items-center gap-2 font-serif text-lg font-semibold text-mangrove-950"
      >
        <img
          src="/logo-ah.svg"
          alt=""
          width="48"
          height="28"
          class="h-7 w-auto shrink-0"
          fetchpriority="high"
        />
        {t.site.name}
      </a>

      <!-- Menu mobile: <details> murni CSS, tidak butuh JavaScript, sesuai
           prinsip situs harus tetap terbaca tanpa JS aktif. -->
      <details class="group relative shrink-0 sm:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-md border border-mangrove-300 px-3 py-1.5 text-sm font-medium text-mangrove-800 [&::-webkit-details-marker]:hidden"
        >
          {t.nav.menu}
        </summary>
        <div class="absolute right-0 z-20 mt-2 w-64 rounded-lg border border-mangrove-200 bg-white p-4 shadow-lg">
          <Nav lang={lang} variant="stack" />
          <div class="mt-4 border-t border-mangrove-100 pt-4">
            <LanguageSwitcher lang={lang} hasAlternate={hasAlternate} />
          </div>
        </div>
      </details>

      <div class="hidden flex-wrap items-center gap-x-6 gap-y-2 sm:flex">
        <Nav lang={lang} />
        <LanguageSwitcher lang={lang} hasAlternate={hasAlternate} />
      </div>
    </div>
  </div>
</header>
