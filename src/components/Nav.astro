---
import { useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  lang: Locale;
  variant?: 'inline' | 'stack';
}

const { lang, variant = 'inline' } = Astro.props;
const t = useTranslations(lang);

const items = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/research/`, label: t.nav.research },
  // Alat mandiri berbahasa Indonesia (public/mangrove-guide/), bukan
  // halaman Astro — path-nya sama untuk kedua bahasa situs.
  { href: `/mangrove-guide/`, label: t.nav.mangroveGuide },
  { href: `/${lang}/herbarium/`, label: t.nav.herbarium },
  { href: `/${lang}/microscopy/`, label: t.nav.microscopy },
  { href: `/${lang}/mangrove-map/`, label: t.nav.mangroveMap },
  { href: `/${lang}/publications/`, label: t.nav.publications },
  { href: `/${lang}/writing/`, label: t.nav.writing },
  { href: `/${lang}/courses/`, label: t.nav.courses },
  { href: `/${lang}/books/`, label: t.nav.books },
  { href: `/${lang}/grants/`, label: t.nav.grants },
  // Halaman Indonesia-only, tidak berprefiks bahasa — sama seperti Mangrove
  // ID Guide di atas.
  { href: '/santai-sejenak/', label: t.nav.santaiSejenak },
  { href: `/${lang}/cv/`, label: t.nav.cv },
  { href: `/${lang}/contact/`, label: t.nav.contact },
];

const currentPath = Astro.url.pathname;
---

<nav aria-label={t.nav.label}>
  <ul
    class:list={[
      'text-sm',
      variant === 'stack' ? 'flex flex-col gap-y-3' : 'flex flex-wrap gap-x-5 gap-y-1',
    ]}
  >
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
            class:list={[
              'text-mangrove-800 transition-colors hover:text-mangrove-600',
              currentPath === item.href &&
                'font-semibold text-mangrove-700 underline decoration-sun-400 decoration-2 underline-offset-[6px]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
