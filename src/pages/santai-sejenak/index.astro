---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Bagian ini sengaja hanya berbahasa Indonesia dan tidak ada padanan
// Inggrisnya (lihat catatan di src/content.config.ts) — teks di halaman
// ini karena itu ditulis langsung, tidak lewat sistem terjemahan.
const lang = 'id';

const posts = (await getCollection('santai', (entry) => !entry.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  lang={lang}
  title="Santai Sejenak — Andri Hendrizal"
  description="Tulisan-tulisan iseng Andri Hendrizal, ditulis dengan gaya serius untuk hal-hal yang sebenarnya tidak serius."
  hasAlternate={false}
>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">Santai Sejenak</h1>
    <p class="mt-2 max-w-2xl text-slate-600">
      Tulisan-tulisan iseng, ditulis dengan gaya serius untuk hal-hal yang sebenarnya tidak serius. Sekadar hiburan
      — jangan dikutip di skripsi.
    </p>

    <div class="mt-8 flex flex-col items-start gap-3 rounded-lg border border-mangrove-200 bg-mangrove-50 p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-serif text-lg font-semibold text-mangrove-950">Lompat Mangrove</h2>
        <p class="mt-1 text-sm text-slate-600">
          Game kecil: lompati akar napas, tunduk di bawah dahan, kumpulkan propagul. Iseng-iseng saja.
        </p>
      </div>
      <a
        href="/mangrove-run/"
        class="shrink-0 rounded-md bg-mangrove-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-mangrove-800"
      >
        Main sekarang →
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-6 text-sm italic text-slate-500">Tulisan baru akan tampil di sini segera.</p>
      ) : (
        <ul class="mt-8 space-y-8">
          {posts.map((post) => (
            <li>
              <h2 class="font-serif text-xl font-semibold text-mangrove-900">
                <a href={`/santai-sejenak/${post.id}/`} class="hover:underline">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-slate-500">
                {post.data.date.toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
                {post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
              </p>
              <p class="mt-2 text-slate-700">{post.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
