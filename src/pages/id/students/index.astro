---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'id';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t.students.title} — ${t.site.name}`} description={t.students.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.students.title}</h1>

    <div class="mt-8">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.students.topicsHeading}</h2>
      <p class="mt-3 text-sm italic text-mangrove-600">{t.students.topicsBody}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.students.expectationsHeading}</h2>
      <p class="mt-3 max-w-2xl text-mangrove-800">{t.students.expectationsBody}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.students.benefitsHeading}</h2>
      <p class="mt-3 max-w-2xl text-mangrove-800">{t.students.benefitsBody}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.students.contactHeading}</h2>
      <p class="mt-3 max-w-2xl text-mangrove-800">{t.students.contactIntro}</p>
      <ul class="mt-3 list-disc space-y-1 pl-5 text-mangrove-800">
        {t.students.contactList.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.students.faqHeading}</h2>
      <dl class="mt-4 space-y-6">
        {
          t.students.faq.map((item) => (
            <div>
              <dt class="font-medium text-mangrove-900">{item.question}</dt>
              <dd class="mt-1 text-mangrove-700">{item.answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
