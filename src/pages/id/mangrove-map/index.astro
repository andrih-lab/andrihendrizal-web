---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import MangroveMap from '../../../components/MangroveMap.astro';

const lang = 'id';
const t = useTranslations(lang);

const staticMaps = [
  { key: 'eksisting', label: t.mangroveMap.eksistingLabel },
  { key: 'potensi', label: t.mangroveMap.potensiLabel },
];
---

<BaseLayout lang={lang} title={`${t.mangroveMap.title} — ${t.site.name}`} description={t.mangroveMap.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.mangroveMap.title}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{t.mangroveMap.intro}</p>

    <MangroveMap lang={lang} />

    <div class="mt-12">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.mangroveMap.staticHeading}</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">{t.mangroveMap.staticIntro}</p>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          staticMaps.map((m) => (
            <li class="overflow-hidden rounded-lg border border-mangrove-200">
              <img
                src={`/mangrove-map/peta-mangrove-${m.key}-id.png`}
                alt={m.label}
                loading="lazy"
                decoding="async"
                class="w-full object-cover"
              />
              <div class="flex items-center justify-between gap-2 p-3 text-sm">
                <span class="font-medium text-mangrove-900">{m.label}</span>
                <span class="flex gap-3">
                  <a
                    href={`/mangrove-map/peta-mangrove-${m.key}-id.png`}
                    download
                    class="text-mangrove-700 hover:underline"
                  >
                    {t.mangroveMap.downloadPng}
                  </a>
                  <a
                    href={`/mangrove-map/peta-mangrove-${m.key}-id.pdf`}
                    download
                    class="text-mangrove-700 hover:underline"
                  >
                    {t.mangroveMap.downloadPdf}
                  </a>
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.mangroveMap.citeHeading}</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-600">{t.mangroveMap.citeIntro}</p>
      <div class="mt-3 flex items-start justify-between gap-3 rounded-lg border border-mangrove-200 bg-mangrove-50 p-4">
        <code id="mangrove-citation" class="text-sm text-slate-700">
          Hendrizal, A. (2026). Peta Sebaran Mangrove Indonesia per Provinsi, 2024. andrihendrizal.com. Data: Kementerian
          Kehutanan RI, Keputusan No. 594/2025. https://andrihendrizal.com/id/mangrove-map/
        </code>
        <button
          type="button"
          id="mangrove-citation-copy"
          data-label-copy={t.mangroveMap.citeCopy}
          data-label-copied={t.mangroveMap.citeCopied}
          class="shrink-0 rounded-md border border-mangrove-300 bg-white px-3 py-1.5 text-xs font-medium text-mangrove-700 hover:bg-mangrove-100"
        >
          {t.mangroveMap.citeCopy}
        </button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const btn = document.getElementById('mangrove-citation-copy');
  const text = document.getElementById('mangrove-citation');

  function selectCitationText() {
    if (!text) return;
    const range = document.createRange();
    range.selectNodeContents(text);
    const selection = window.getSelection();
    selection?.removeAllRanges();
    selection?.addRange(range);
  }

  btn?.addEventListener('click', async () => {
    if (!text) return;
    const value = text.textContent?.trim().replace(/\s+/g, ' ') ?? '';
    const original = btn.getAttribute('data-label-copy');
    let copied = false;
    try {
      await navigator.clipboard.writeText(value);
      copied = true;
    } catch {
      // Izin clipboard ditolak (umum di browser lama/konteks tertentu) —
      // sebagai gantinya, pilih teksnya supaya pengguna bisa salin manual
      // (Ctrl/Cmd+C).
      selectCitationText();
    }
    btn.textContent = copied ? btn.getAttribute('data-label-copied') : original;
    setTimeout(() => {
      if (original) btn.textContent = original;
    }, 2000);
  });
</script>
