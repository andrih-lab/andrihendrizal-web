---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TalkList from '../../../components/TalkList.astro';
import { useTranslations } from '../../../i18n/utils';
import { talks } from '../../../data/talks';

const lang = 'id';
const t = useTranslations(lang);

// Data terstruktur VideoObject agar video bisa tampil (dengan thumbnail) di hasil pencarian Google.
const videoJsonLd = talks
  .filter((talk) => talk.youtubeId && talk.video)
  .map((talk) => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: talk.title,
    description: talk.summary[lang],
    thumbnailUrl: `https://i.ytimg.com/vi/${talk.youtubeId}/hqdefault.jpg`,
    uploadDate: talk.video!.uploadDate,
    duration: talk.video!.durationIso,
    embedUrl: `https://www.youtube-nocookie.com/embed/${talk.youtubeId}`,
    contentUrl: `https://www.youtube.com/watch?v=${talk.youtubeId}`,
    author: { '@type': 'Person', name: 'Andri Hendrizal', url: 'https://andrihendrizal.com/' },
  }));
---

<BaseLayout lang={lang} title={`${t.talks.title} — ${t.site.name}`} description={t.talks.description}>
  {videoJsonLd.map((v) => <script slot="head" type="application/ld+json" set:html={JSON.stringify(v)} />)}
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.talks.title}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{t.talks.intro}</p>
    <TalkList lang={lang} />
  </section>
</BaseLayout>
