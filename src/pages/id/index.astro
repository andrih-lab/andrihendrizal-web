---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { academicProfiles } from '../../data/profiles';
import { getPublications, isSiteOwner } from '../../lib/openalex';

const lang = 'id';
const t = useTranslations(lang);

const publications = await getPublications();
const recentPublications = publications.slice(0, 3);

// JSON-LD Person (Bagian 8: data terstruktur di beranda, memuat ORCID dan
// afiliasi).
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.site.name,
  jobTitle: t.home.heroPosition,
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Universitas Riau' },
  url: new URL(`/${lang}/`, Astro.site).toString(),
  image: new URL('/images/portrait.webp', Astro.site).toString(),
  sameAs: academicProfiles.filter((p) => p.url !== '#').map((p) => p.url),
};
---

<BaseLayout
  lang={lang}
  title={t.site.title}
  description={t.site.description}
  image="/images/portrait.webp"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <img
        src="/images/portrait.webp"
        alt={t.site.name}
        width="160"
        height="160"
        class="h-40 w-40 rounded-full border border-mangrove-200 object-cover"
      />
      <div>
        <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.site.name}</h1>
        <p class="mt-2 text-mangrove-700">{t.home.heroPosition}</p>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.introHeading}</h2>
      <!-- TODO: paragraf perkenalan ~100 kata dari pemilik situs (Bagian 12) -->
      <p class="mt-3 max-w-2xl text-mangrove-800">{t.home.intro}</p>
      <p class="mt-3 max-w-2xl text-sm text-mangrove-700">{t.home.internationalNote}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.focusHeading}</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-3">
        {
          t.focusAreas.map((area) => (
            <li class="rounded-lg border border-mangrove-200 bg-white/50 p-4">
              <h3 class="font-semibold text-mangrove-900">{area.title}</h3>
              <p class="mt-1 text-sm text-mangrove-700">{area.description}</p>
            </li>
          ))
        }
      </ul>
      <!-- TODO: kalimat kontribusi utama riset dari pemilik situs -->
      <p class="mt-4 text-mangrove-800">{t.home.contributionStatement}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.publicationsHeading}</h2>
      {
        recentPublications.length > 0 ? (
          <ul class="mt-4 space-y-4">
            {recentPublications.map((pub) => (
              <li>
                <p class="font-medium text-mangrove-900">
                  {pub.doi ? (
                    <a href={pub.doi} target="_blank" rel="noopener" class="hover:underline">
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                </p>
                <p class="text-sm text-mangrove-700">
                  {pub.authors.map((name, i) => (
                    <>
                      <span class:list={[isSiteOwner(name) && 'font-semibold text-mangrove-950']}>{name}</span>
                      {i < pub.authors.length - 1 && ', '}
                    </>
                  ))}
                </p>
                <p class="text-sm text-mangrove-600">
                  {pub.venue && `${pub.venue} · `}
                  {pub.year}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-sm italic text-mangrove-600">{t.home.publicationsEmpty}</p>
        )
      }
      <p class="mt-4 text-sm">
        <a href={`/${lang}/publications/`} class="text-mangrove-800 underline hover:text-mangrove-950">
          {t.nav.publications} →
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.writingHeading}</h2>
      <!-- TODO (Tahap 3): sistem tulisan, lihat Bagian 5 Writing -->
      <p class="mt-3 text-sm italic text-mangrove-600">{t.home.writingPlaceholder}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.profilesHeading}</h2>
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {
          academicProfiles.map((profile) => (
            <li>
              <a
                href={profile.url}
                class="text-mangrove-800 underline hover:text-mangrove-950"
                rel="me noopener"
                target="_blank"
              >
                {profile.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
