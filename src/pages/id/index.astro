---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { talks } from '../../data/talks';
import { useTranslations } from '../../i18n/utils';
import { academicProfiles } from '../../data/profiles';
import { getPublications, isSiteOwner } from '../../lib/openalex';
import { getCollection } from 'astro:content';
import { portraits } from '../../data/portraits';

const lang = 'id';
const t = useTranslations(lang);
const latestTalk = talks[0];

const publications = await getPublications();
const recentPublications = publications.slice(0, 3);

const recentPosts = (await getCollection('writing', (entry) => entry.data.lang === lang && !entry.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

// JSON-LD Person (Bagian 8: data terstruktur di beranda, memuat ORCID dan
// afiliasi). alumniOf dan worksFor ditambahkan supaya Google punya sinyal
// identitas/afiliasi yang lebih lengkap untuk Knowledge Panel — lihat data/cv.ts
// untuk detail pendidikan.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: t.site.name,
  jobTitle: t.home.heroPosition,
  description: t.site.description,
  worksFor: { '@type': 'CollegeOrUniversity', name: 'Universitas Riau' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universitas Riau' },
    { '@type': 'CollegeOrUniversity', name: 'Universitas Gadjah Mada' },
    { '@type': 'CollegeOrUniversity', name: 'Universiti Malaya' },
  ],
  url: new URL(`/${lang}/`, Astro.site).toString(),
  image: new URL('/images/portrait.webp', Astro.site).toString(),
  sameAs: academicProfiles.map((p) => p.url),
};
---

<BaseLayout
  lang={lang}
  title={t.site.title}
  description={t.site.description}
  image="/images/portrait.webp"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <!-- Pita pembuka: latar biru muda + dua segitiga oranye di sudut, meniru logo AH. -->
  <div class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
    <div aria-hidden="true" class="pointer-events-none absolute left-0 top-0 h-24 w-14 bg-sun-400 sm:h-36 sm:w-20" style="clip-path: polygon(0 0, 100% 0, 0 100%)"></div>
    <div aria-hidden="true" class="pointer-events-none absolute right-0 top-0 h-24 w-14 bg-sun-400 sm:h-36 sm:w-20" style="clip-path: polygon(0 0, 100% 0, 100% 100%)"></div>
    <div class="relative mx-auto flex max-w-4xl flex-col items-start gap-6 px-4 pt-12 pb-4 sm:flex-row sm:items-center">
      <img
        id="hero-portrait"
        src="/images/portrait.webp"
        alt={t.site.name}
        width="160"
        height="160"
        class="h-40 w-40 rounded-full object-cover ring-4 ring-sun-400 ring-offset-4 ring-offset-brand-50"
      />
      <div>
        <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.site.name}</h1>
        <p class="mt-2 text-slate-600">{t.home.heroPosition}</p>
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-4xl px-4 pb-12">

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.introHeading}</h2>
      <p class="mt-3 max-w-2xl text-slate-700">{t.home.intro}</p>
      <p class="mt-3 max-w-2xl text-sm text-slate-600">{t.home.internationalNote}</p>
      <p class="mt-3 max-w-2xl text-sm text-slate-600">{t.home.backgroundNote}</p>
    </div>

    {
      latestTalk && (
        <div class="mt-10">
          <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.latestTalkHeading}</h2>
          <a
            href={`/${lang}/talks/#${latestTalk.id}`}
            class="group mt-4 flex flex-col gap-4 rounded-lg border border-mangrove-200 bg-mangrove-50 p-4 transition-colors hover:border-sun-400 sm:flex-row sm:items-center"
          >
            {latestTalk.youtubeId && (
              <span class="relative block shrink-0 overflow-hidden rounded-md sm:w-56">
                <img
                  src={`https://i.ytimg.com/vi/${latestTalk.youtubeId}/hqdefault.jpg`}
                  alt=""
                  width="480"
                  height="360"
                  loading="lazy"
                  class="aspect-video w-full object-cover"
                />
                <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                  <span class="flex h-11 w-11 items-center justify-center rounded-full bg-sun-400 text-lg text-brand-950 shadow-md transition-transform group-hover:scale-110">▶</span>
                </span>
              </span>
            )}
            <span class="block">
              <span class="block text-xs font-semibold uppercase tracking-wide text-sun-700">
                {latestTalk.eventShort} · {latestTalk.location[lang]} · {latestTalk.dateLabel[lang]}
              </span>
              <span class="mt-1 block font-semibold text-mangrove-900 group-hover:underline">{latestTalk.title}</span>
              <span class="mt-2 block text-sm text-mangrove-700">{t.home.latestTalkCta} →</span>
            </span>
          </a>
        </div>
      )
    }

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.focusHeading}</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          t.focusAreas.map((area) => (
            <li class="border-l-2 border-mangrove-300 pl-4 py-1">
              <h3 class="font-semibold text-mangrove-900">{area.title}</h3>
              <p class="mt-1 text-sm text-slate-600">{area.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-slate-700">{t.home.contributionStatement}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.publicationsHeading}</h2>
      {
        recentPublications.length > 0 ? (
          <ul class="mt-4 space-y-4">
            {recentPublications.map((pub) => (
              <li>
                <p class="font-medium text-mangrove-900">
                  {pub.doi ? (
                    <a href={pub.doi} target="_blank" rel="noopener" class="hover:underline">
                      {pub.title}
                    </a>
                  ) : (
                    pub.title
                  )}
                </p>
                <p class="text-sm text-slate-600">
                  {pub.authors.map((name, i) => (
                    <>
                      <span class:list={[isSiteOwner(name) && 'font-semibold text-mangrove-950']}>{name}</span>
                      {i < pub.authors.length - 1 && ', '}
                    </>
                  ))}
                </p>
                <p class="text-sm text-slate-500">
                  {pub.venue && `${pub.venue} · `}
                  {pub.year}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-sm italic text-slate-500">{t.home.publicationsEmpty}</p>
        )
      }
      <p class="mt-4 text-sm">
        <a href={`/${lang}/publications/`} class="text-mangrove-800 underline hover:text-mangrove-950">
          {t.nav.publications} →
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.writingHeading}</h2>
      {
        recentPosts.length > 0 ? (
          <ul class="mt-4 space-y-4">
            {recentPosts.map((post) => (
              <li>
                <a
                  href={`/${lang}/writing/${post.id.split('/').slice(1).join('/')}/`}
                  class="font-medium text-mangrove-900 hover:underline"
                >
                  {post.data.title}
                </a>
                <p class="text-sm text-slate-500">{post.data.description}</p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 text-sm italic text-slate-500">{t.home.writingEmpty}</p>
        )
      }
      <p class="mt-4 text-sm">
        <a href={`/${lang}/writing/`} class="text-mangrove-800 underline hover:text-mangrove-950">
          {t.nav.writing} →
        </a>
      </p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.profilesHeading}</h2>
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {
          academicProfiles.map((profile) => (
            <li>
              <a
                href={profile.url}
                class="text-mangrove-800 underline hover:text-mangrove-950"
                rel="me noopener"
                target="_blank"
              >
                {profile.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <script define:vars={{ portraits }}>
    // Progressive enhancement only (Prinsip #2): tanpa JS, <img> di atas
    // tetap tampil dengan src default-nya. Pilihan acak per-kunjungan
    // sederhana ini tidak butuh persistensi (localStorage dsb.).
    const img = document.getElementById('hero-portrait');
    if (img && portraits.length > 1) {
      const choice = portraits[Math.floor(Math.random() * portraits.length)];
      if (choice !== img.getAttribute('src')) img.setAttribute('src', choice);
    }
  </script>
</BaseLayout>
