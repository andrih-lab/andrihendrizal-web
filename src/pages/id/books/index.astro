---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'id';
const t = useTranslations(lang);

const books = (await getCollection('books')).sort((a, b) => b.data.year - a.data.year);

const formatLabels: Record<string, string> = { print: 'Cetak', pdf: 'PDF', epub: 'EPUB' };
---

<BaseLayout lang={lang} title={`${t.books.title} — ${t.site.name}`} description={t.books.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.books.title}</h1>

    {
      books.length === 0 ? (
        <p class="mt-6 text-sm italic text-mangrove-600">{t.books.empty}</p>
      ) : (
        <ul class="mt-8 grid gap-8 sm:grid-cols-2">
          {books.map((book) => (
            <li class="rounded-lg border border-mangrove-200 bg-white/50 p-4">
              {book.data.cover && (
                <img
                  src={book.data.cover}
                  alt={book.data.title}
                  loading="lazy"
                  decoding="async"
                  class="mb-4 h-48 w-full rounded object-cover"
                />
              )}
              <h2 class="font-serif text-lg font-semibold text-mangrove-900">{book.data.title}</h2>
              <p class="mt-1 text-sm text-mangrove-600">
                {book.data.year}
                {book.data.isbn && ` · ${t.books.isbnLabel} ${book.data.isbn}`}
              </p>
              <p class="mt-2 text-sm text-mangrove-800">{book.data.description}</p>
              {book.data.formats.length > 0 && (
                <p class="mt-2 text-xs text-mangrove-600">
                  {t.books.formatsLabel}: {book.data.formats.map((f) => formatLabels[f] ?? f).join(', ')}
                </p>
              )}
              {book.data.quote && <p class="mt-2 text-sm italic text-mangrove-700">"{book.data.quote}"</p>}
              {book.data.purchaseUrl && (
                <a
                  href={book.data.purchaseUrl}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-block rounded border border-mangrove-700 px-3 py-1.5 text-sm font-semibold text-mangrove-800 hover:bg-mangrove-700 hover:text-cream"
                >
                  {t.books.buyButton}
                </a>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
