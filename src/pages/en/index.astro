---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { academicProfiles } from '../../data/profiles';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.site.title} description={t.site.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
      <!-- TODO: ganti dengan foto potret profesional (lihat Bagian 12) -->
      <img
        src="/images/placeholder-portrait.svg"
        alt={t.site.name}
        width="160"
        height="160"
        class="h-40 w-40 rounded-full border border-mangrove-200 object-cover"
      />
      <div>
        <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.site.name}</h1>
        <p class="mt-2 text-mangrove-700">{t.home.heroPosition}</p>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.introHeading}</h2>
      <!-- TODO: paragraf perkenalan ~100 kata dari pemilik situs (Bagian 12) -->
      <p class="mt-3 max-w-2xl text-mangrove-800">{t.home.intro}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.focusHeading}</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-3">
        {
          t.home.focusAreas.map((area) => (
            <li class="rounded-lg border border-mangrove-200 bg-white/50 p-4">
              <h3 class="font-semibold text-mangrove-900">{area.title}</h3>
              <p class="mt-1 text-sm text-mangrove-700">{area.description}</p>
            </li>
          ))
        }
      </ul>
      <!-- TODO: kalimat kontribusi utama riset dari pemilik situs -->
      <p class="mt-4 text-mangrove-800">{t.home.contributionStatement}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.publicationsHeading}</h2>
      <!-- TODO (Tahap 2): integrasi OpenAlex, lihat Bagian 5 Publications -->
      <p class="mt-3 text-sm italic text-mangrove-600">{t.home.publicationsPlaceholder}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.writingHeading}</h2>
      <!-- TODO (Tahap 3): sistem tulisan, lihat Bagian 5 Writing -->
      <p class="mt-3 text-sm italic text-mangrove-600">{t.home.writingPlaceholder}</p>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.home.profilesHeading}</h2>
      <ul class="mt-3 flex flex-wrap gap-4 text-sm">
        {
          academicProfiles.map((profile) => (
            <li>
              <a
                href={profile.url}
                class="text-mangrove-800 underline hover:text-mangrove-950"
                rel="me noopener"
                target="_blank"
              >
                {profile.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
