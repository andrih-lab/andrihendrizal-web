---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { education, experience, training, grants, technicalSkills } from '../../../data/cv';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t.cv.title} — ${t.site.name}`} description={t.cv.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.cv.title}</h1>
      <!-- TODO: unggah berkas ke public/cv-andri-hendrizal.pdf agar tombol ini aktif -->
      <a
        href="/cv-andri-hendrizal.pdf"
        class="rounded border border-mangrove-700 px-4 py-2 text-sm font-semibold text-mangrove-800 hover:bg-mangrove-700 hover:text-cream"
      >
        {t.cv.downloadPdf}
      </a>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.educationHeading}</h2>
      <ul class="mt-4 space-y-4">
        {
          education.map((item) => (
            <li>
              <p class="font-medium text-mangrove-900">{item.degree[lang]}</p>
              <p class="text-sm text-mangrove-700">{item.institution[lang]}</p>
              <p class="text-sm text-mangrove-600">{item.period}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.experienceHeading}</h2>
      <ul class="mt-4 space-y-4">
        {
          experience.map((item) => (
            <li>
              <p class="font-medium text-mangrove-900">
                {item.role[lang]}
                {item.international && (
                  <span class="ml-2 rounded bg-brackish-500/20 px-1.5 py-0.5 text-xs font-normal text-mangrove-800">
                    {t.cv.internationalBadge}
                  </span>
                )}
              </p>
              <p class="text-sm text-mangrove-700">{item.organization[lang]}</p>
              <p class="text-sm text-mangrove-600">
                {item.period} · {item.location}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.trainingHeading}</h2>
      <ul class="mt-4 space-y-4">
        {
          training.map((item) => (
            <li>
              <p class="font-medium text-mangrove-900">
                {item.name[lang]}
                {item.international && (
                  <span class="ml-2 rounded bg-brackish-500/20 px-1.5 py-0.5 text-xs font-normal text-mangrove-800">
                    {t.cv.internationalBadge}
                  </span>
                )}
              </p>
              <p class="text-sm text-mangrove-700">{item.provider[lang]}</p>
              <p class="text-sm text-mangrove-600">
                {item.location[lang]} · {item.year}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.grantsHeading}</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full min-w-[28rem] text-left text-sm">
          <thead>
            <tr class="border-b border-mangrove-300 text-mangrove-600">
              <th scope="col" class="py-2 pr-4 font-semibold">
                {t.cv.grantsYear}
              </th>
              <th scope="col" class="py-2 pr-4 font-semibold">
                {t.cv.grantsFunder}
              </th>
              <th scope="col" class="py-2 font-semibold">
                {t.cv.grantsTitle}
              </th>
            </tr>
          </thead>
          <tbody>
            {
              grants.map((grant) => (
                <tr class="border-b border-mangrove-100">
                  <td class="py-2 pr-4 text-mangrove-700">{grant.year}</td>
                  <td class="py-2 pr-4 text-mangrove-700">{grant.funder[lang]}</td>
                  <td class="py-2 text-mangrove-800">{grant.title[lang]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.skillsHeading}</h2>
      <ul class="mt-4 grid gap-6 sm:grid-cols-3">
        {
          technicalSkills.map((skill) => (
            <li class="rounded-lg border border-mangrove-200 bg-white/50 p-4">
              <h3 class="font-semibold text-mangrove-900">{skill.title[lang]}</h3>
              <p class="mt-1 text-sm text-mangrove-700">{skill.description[lang]}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-10">
      <h2 class="font-serif text-xl font-semibold text-mangrove-900">{t.cv.rankingsHeading}</h2>
      <!-- TODO: peringkat AD Scientific Index dsb. belum tersedia dari pemilik situs -->
      <p class="mt-3 text-sm italic text-mangrove-600">{t.cv.rankingsTodo}</p>
    </div>
  </section>
</BaseLayout>
