---
import libraryRef from '../../../../scripts/library-reference.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';
import { getCollection, render } from 'astro:content';

const lang = 'en';
// Warna label punggung menurut kelas utama DDC (digit pertama kode).
const spineColors = ['#475569', '#6d5a9c', '#8b5e3c', '#a16207', '#9f4a5a', '#035297', '#b45309', '#7c3f98', '#be5a38', '#3f6b4f'];
const spineParts = (call?: string) => {
  const [ddc, author, title] = (call ?? '').split(' ');
  return ddc && author && title ? { ddc, author, title, color: spineColors[Number(ddc[0])] ?? spineColors[0] } : null;
};
const countryName = (id: string) => libraryRef.negara.find((n) => n.id === id)?.[lang] ?? id;
// Emoji bendera dari kode negara ISO (dua huruf → regional indicator); kosong = tanpa bendera.
const countryFlag = (id: string) => {
  const code = libraryRef.negara.find((n) => n.id === id)?.kode;
  return code ? String.fromCodePoint(...[...code].map((c) => 0x1f1e6 + c.charCodeAt(0) - 65)) : '';
};
const t = useTranslations(lang);

const books = (await getCollection('library', (entry) => !entry.data.draft)).sort((a, b) =>
  a.data.catalogNumber.localeCompare(b.data.catalogNumber),
);

// Render badan Markdown (ringkasan/kesan) tiap buku sekaligus di sini —
// halaman ini satu-satunya tempat koleksi bacaan tampil, tidak ada
// halaman detail per buku (Bagian: "sederhana, bukan resensi formal").
const rendered = await Promise.all(books.map((book) => render(book)));

const categories = [...new Set(books.flatMap((b) => b.data.categories))].sort((a, b) => a.localeCompare(b));
const formats = [...new Set(books.flatMap((b) => b.data.formats))];

const formatLabels: Record<string, string> = {
  cetak: t.library.formatCetak,
  pdf: t.library.formatPdf,
  epub: t.library.formatEpub,
  'google-play': t.library.formatGooglePlay,
};
---

<BaseLayout lang={lang} title={`${t.library.title} — ${t.site.name}`} description={t.library.description}>
  <section class="mx-auto max-w-4xl px-4 py-12">
    <h1 class="font-serif text-3xl font-semibold text-mangrove-950">{t.library.title}</h1>
    <p class="mt-2 max-w-2xl text-slate-600">{t.library.intro}</p>

    {
      books.length === 0 ? (
        <p class="mt-6 text-sm italic text-slate-500">{t.library.empty}</p>
      ) : (
        <>
          {(
            <form id="library-filters" class="mt-6 flex flex-wrap items-end gap-4 rounded-xl bg-mangrove-50 p-4 text-sm">
              <div class="w-full sm:w-auto sm:min-w-72">
                <label for="filter-search" class="block text-slate-600">
                  {t.library.searchLabel}
                </label>
                <input
                  id="filter-search"
                  type="search"
                  autocomplete="off"
                  placeholder={t.library.searchPlaceholder}
                  class="mt-1 w-full rounded border border-mangrove-300 bg-white px-2 py-1"
                />
              </div>
              {categories.length > 0 && (
                <div>
                  <label for="filter-category" class="block text-slate-600">
                    {t.library.filterCategory}
                  </label>
                  <select id="filter-category" class="mt-1 rounded border border-mangrove-300 bg-white px-2 py-1">
                    <option value="">{t.library.filterAll}</option>
                    {categories.map((c) => (
                      <option value={c}>{c}</option>
                    ))}
                  </select>
                </div>
              )}
              {formats.length > 0 && (
                <div>
                  <label for="filter-format" class="block text-slate-600">
                    {t.library.filterFormat}
                  </label>
                  <select id="filter-format" class="mt-1 rounded border border-mangrove-300 bg-white px-2 py-1">
                    <option value="">{t.library.filterAll}</option>
                    {formats.map((f) => (
                      <option value={f}>{formatLabels[f] ?? f}</option>
                    ))}
                  </select>
                </div>
              )}
              <p id="library-count" data-template={t.library.countShowing} data-total={books.length} class="w-full text-xs text-slate-500">
                {t.library.countShowing.replace('{n}', String(books.length)).replace('{total}', String(books.length))}
              </p>
              <p id="filter-empty-note" hidden class="w-full text-slate-500">
                {t.library.filterNoResults}
              </p>
            </form>
          )}

          <ul id="library-list" class="mt-6 grid gap-5 sm:grid-cols-2">
            {books.map((book, i) => {
              const { Content } = rendered[i];
              const spine = spineParts(book.data.callNumber);
              const meta = [
                book.data.publisher,
                book.data.year,
                book.data.pages && `${book.data.pages} ${t.library.pagesLabel}`,
                book.data.isbn && `${t.library.isbnLabel} ${book.data.isbn}`,
              ].filter(Boolean);
              return (
                <li
                  data-book
                  data-search={[
                    book.data.catalogNumber,
                    book.data.callNumber,
                    book.data.title,
                    book.data.subtitle,
                    book.data.author,
                    book.data.coAuthors,
                    book.data.publisher,
                    book.data.isbn,
                    book.data.year,
                    ...book.data.categories,
                  ]
                    .filter(Boolean)
                    .join(' ')
                    .normalize('NFD')
                    .replace(/[̀-ͯ]/g, '')
                    .toLowerCase()}
                  data-categories={book.data.categories.join('|')}
                  data-formats={book.data.formats.join('|')}
                  class="flex gap-3 rounded-xl border border-mangrove-200 bg-white p-3 shadow-sm sm:gap-4 sm:p-4 transition-shadow hover:shadow-md"
                >
                  {spine && (
                    <div
                      aria-hidden="true"
                      class="flex h-24 w-14 shrink-0 sm:h-28 sm:w-[4.5rem] flex-col items-center justify-center rounded-md font-mono text-white"
                      style={`background-color:${spine.color};box-shadow:inset 4px 0 0 rgba(0,0,0,.2),0 1px 2px rgba(0,0,0,.2)`}
                    >
                      <span class="text-xs font-semibold leading-tight">{spine.ddc}</span>
                      <span class="mt-1.5 text-sm font-bold leading-tight">{spine.author}</span>
                      <span class="mt-1 text-sm leading-tight">{spine.title}</span>
                    </div>
                  )}
                  <div class="min-w-0 flex-1">
                    <p class="font-mono text-[11px] tracking-wide text-slate-400">
                      {book.data.catalogNumber}
                      {book.data.callNumber && ` · ${book.data.callNumber}`}
                    </p>
                    <h2 class="mt-0.5 font-serif text-lg font-semibold leading-snug text-mangrove-900">{book.data.title}</h2>
                    {book.data.subtitle && <p class="text-sm italic leading-snug text-slate-500">{book.data.subtitle}</p>}
                    <p class="mt-2 line-clamp-2 text-sm text-slate-700">
                      {book.data.author}
                      {book.data.coAuthors && `, ${book.data.coAuthors}`}
                    </p>
                    <p class="mt-1 text-xs leading-relaxed text-slate-500">
                      {meta.join(' · ')}
                      {book.data.acquiredIn && (
                        <>
                          {meta.length > 0 && ' · '}
                          <span aria-hidden="true">{countryFlag(book.data.acquiredIn)}</span> {countryName(book.data.acquiredIn)}
                        </>
                      )}
                    </p>

                    <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
                      {book.data.formats.map((f) => (
                        <span class="rounded-full bg-mangrove-50 px-2 py-0.5 text-slate-600 ring-1 ring-inset ring-mangrove-200">
                          {formatLabels[f] ?? f}
                        </span>
                      ))}
                      {book.data.categories.map((c) => (
                        <span class="rounded-full bg-mangrove-100 px-2 py-0.5 text-slate-700">{c}</span>
                      ))}
                      {book.data.rating && (
                        <span class="ml-auto text-amber-500" aria-label={`${t.library.ratingLabel}: ${book.data.rating}/5`}>
                          {'★'.repeat(book.data.rating)}
                          <span class="text-slate-300">{'★'.repeat(5 - book.data.rating)}</span>
                        </span>
                      )}
                    </div>

                    {book.body?.trim() && (
                      <div class="prose prose-sm prose-neutral mt-3 max-w-none border-t border-mangrove-100 pt-3">
                        <Content />
                      </div>
                    )}

                    {book.data.link && (
                      <a
                        href={book.data.link}
                        target="_blank"
                        rel="noopener"
                        class="mt-2 inline-block text-sm font-medium text-mangrove-700 hover:underline"
                      >
                        {t.library.linkLabel} →
                      </a>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  // Penyaring progresif dua filter (subjek + format), pola sama seperti
  // filter kategori di halaman Herbarium. Tanpa JS, seluruh koleksi tetap
  // tampil dan terbaca penuh — skrip ini hanya lapisan kenyamanan opsional.
  const categorySelect = document.getElementById('filter-category') as HTMLSelectElement | null;
  const formatSelect = document.getElementById('filter-format') as HTMLSelectElement | null;
  const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
  const countNote = document.getElementById('library-count');
  const emptyNote = document.getElementById('filter-empty-note');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#library-list [data-book]'));

  function applyFilters() {
    const category = categorySelect?.value ?? '';
    const format = formatSelect?.value ?? '';
    // Semua kata yang diketik harus ada (AND); huruf beraksen & besar-kecil diabaikan.
    const words = (searchInput?.value ?? '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .split(/\s+/)
      .filter(Boolean);
    let visibleCount = 0;
    for (const item of items) {
      const categories = (item.dataset.categories ?? '').split('|');
      const formats = (item.dataset.formats ?? '').split('|');
      const visible = (!category || categories.includes(category)) && (!format || formats.includes(format)) &&
        words.every((w) => (item.dataset.search ?? '').includes(w));
      item.hidden = !visible;
      if (visible) visibleCount++;
    }
    if (emptyNote) emptyNote.hidden = visibleCount !== 0;
    if (countNote) {
      countNote.textContent = (countNote.dataset.template ?? '')
        .replace('{n}', String(visibleCount))
        .replace('{total}', countNote.dataset.total ?? '');
    }
  }

  categorySelect?.addEventListener('change', applyFilters);
  formatSelect?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);
  document.getElementById('library-filters')?.addEventListener('submit', (e) => e.preventDefault());
</script>
