---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, DEFAULT_LOCALE } from '../i18n/config';
import { getAlternatePath } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import '../styles/global.css';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Path/URL gambar OG (mis. "/images/portrait.webp"). Opsional — meta
   * og:image/twitter:image diabaikan bila tidak diisi (mis. halaman tanpa
   * gambar yang representatif). */
  image?: string;
  /** "article" untuk halaman tulisan, default "website". */
  type?: 'website' | 'article';
}

const { lang, title, description, image, type = 'website' } = Astro.props;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    {
      LOCALES.map((locale) => (
        <link rel="alternate" hreflang={locale} href={new URL(getAlternatePath(pathname, locale), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(getAlternatePath(pathname, DEFAULT_LOCALE), Astro.site)} />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph & Twitter Card (Bagian 8: pratinjau saat dibagikan di
    WhatsApp dan media sosial) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Andri Hendrizal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col bg-cream font-sans text-mangrove-950">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
